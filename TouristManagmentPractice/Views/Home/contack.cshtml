
@model TouristManagmentPractice.Models.contackmessage

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Contact Us - TravelGo</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f5f8fa;
            color: #222;
        }

        /* ================= NAVBAR ================= */

        .navbar {
            background: #071c2c;
            padding: 15px 7%;
        }

        .navbar-brand {
            font-size: 28px;
            font-weight: 800;
            color: white !important;
        }

            .navbar-brand span {
                color: #00d9ff;
            }

        .nav-link {
            color: white !important;
            font-weight: 500;
            margin-left: 20px;
            transition: 0.3s;
        }

            .nav-link:hover {
                color: #00d9ff !important;
            }

        /* ================= HERO ================= */

        .contact-hero {
            height: 430px;
            background: linear-gradient( rgba(0, 25, 45, 0.70), rgba(0, 25, 45, 0.70) ), url("https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1800&q=85");
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
        }

        .hero-content h1 {
            font-size: 55px;
            font-weight: 800;
            margin-bottom: 15px;
        }

            .hero-content h1 span {
                color: #00d9ff;
            }

        .hero-content p {
            font-size: 18px;
            max-width: 650px;
            margin: auto;
            color: #e7f8ff;
        }

        /* ================= CONTACT SECTION ================= */

        .contact-section {
            padding: 80px 7%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 55px;
        }

            .section-title small {
                color: #00aeca;
                font-weight: 700;
                letter-spacing: 2px;
            }

            .section-title h2 {
                font-size: 40px;
                font-weight: 700;
                margin-top: 8px;
            }

            .section-title p {
                color: #777;
                max-width: 650px;
                margin: 12px auto;
            }

        /* ================= CONTACT CARD ================= */

        .contact-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.10);
            height: 100%;
        }

            .contact-card h3 {
                font-weight: 700;
                margin-bottom: 25px;
            }

        /* ================= INPUT ================= */

        .form-label {
            font-weight: 600;
            color: #333;
        }

        .form-control,
        .form-select {
            border: 1px solid #ddd;
            border-radius: 10px;
            padding: 13px 15px;
            transition: 0.3s;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #00cfe8;
                box-shadow: 0 0 0 0.2rem rgba(0,207,232,0.12);
            }

        textarea.form-control {
            min-height: 140px;
            resize: none;
        }

        /* ================= SEND BUTTON ================= */

        .send-btn {
            width: 100%;
            border: none;
            padding: 14px;
            border-radius: 30px;
            background: linear-gradient( 90deg, #00aeca, #00d9ff );
            color: white;
            font-size: 16px;
            font-weight: 600;
            transition: 0.3s;
        }

            .send-btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0,180,220,0.30);
            }

        /* ================= INFORMATION ================= */

        .info-box {
            display: flex;
            align-items: center;
            padding: 18px;
            margin-bottom: 18px;
            border-radius: 14px;
            background: #f6fbfc;
            transition: 0.3s;
        }

            .info-box:hover {
                transform: translateX(5px);
                background: #e9faff;
            }

        .info-icon {
            min-width: 55px;
            height: 55px;
            border-radius: 50%;
            background: #00cfe8;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
            margin-right: 18px;
        }

        .info-box h5 {
            margin: 0;
            font-weight: 700;
        }

        .info-box p {
            margin: 4px 0 0;
            color: #777;
        }

        /* ================= SOCIAL ================= */

        .social-icons {
            margin-top: 30px;
        }

            .social-icons a {
                display: inline-flex;
                width: 45px;
                height: 45px;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #071c2c;
                color: white;
                text-decoration: none;
                margin-right: 8px;
                font-size: 19px;
                transition: 0.3s;
            }

                .social-icons a:hover {
                    background: #00cfe8;
                    transform: translateY(-5px);
                }

        /* ================= MAP ================= */

        .map-section {
            padding: 0 7% 80px;
        }

        .map-box {
            height: 350px;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 35px rgba(0,0,0,0.12);
        }

            .map-box iframe {
                width: 100%;
                height: 100%;
                border: 0;
            }

        /* ================= FOOTER ================= */

        footer {
            background: #071c2c;
            color: white;
            text-align: center;
            padding: 30px;
        }

            footer span {
                color: #00d9ff;
            }

        /* ================= RESPONSIVE ================= */

        @@media (max-width: 768px) {

            .hero-content h1 {
                font-size: 40px;
            }

            .contact-hero {
                height: 380px;
            }

            .contact-card {
                padding: 25px;
            }

            .section-title h2 {
                font-size: 32px;
            }
        }
    </style>

</head>

<body>

    <!-- ================= HERO ================= -->

    <section class="contact-hero">

        <div class="hero-content">

            <h1>
                Contact <span>Us</span>
            </h1>

            <p>
                Have a question about your next adventure?
                Our travel team is here to help you plan
                an unforgettable journey.
            </p>

        </div>

    </section>


    <!-- ================= CONTACT SECTION ================= -->

    <section class="contact-section">

        <div class="section-title">

            <small>GET IN TOUCH</small>

            <h2>We'd Love To Hear From You</h2>

            <p>
                Send us a message and our travel experts
                will get back to you as soon as possible.
            </p>

        </div>


        <div class="row g-5">


            <!-- ================= FORM ================= -->

            <div class="col-lg-7">

                <div class="contact-card">

                    <h3>
                        Send Us A Message
                    </h3>


                    @using (Html.BeginForm("contack", "Home", FormMethod.Post))
                    {

                        <div class="row">

                            <!-- FULL NAME -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Full Name
                                </label>

                                <input type="text"
                                       class="form-control"
                                       placeholder="Enter your name"
                                       name="fullname"
                                       required />

                            </div>


                            <!-- EMAIL -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Email Address
                                </label>

                                <input type="email"
                                       class="form-control"
                                       name="emailaddress"
                                       placeholder="Enter your email"
                                       required />

                            </div>

                        </div>


                        <div class="row">

                            <!-- MOBILE -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Mobile Number
                                </label>

                                <input type="tel"
                                       class="form-control"
                                       name="mobilenumber"
                                       placeholder="Enter mobile number"
                                       required />

                            </div>


                            <!-- SUBJECT -->

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Subject
                                </label>

                                <select class="form-select"
                                        name="subject"
                                        required>

                                    <option value="">
                                        Select Subject
                                    </option>

                                    <option value="Tour Package">
                                        Tour Package
                                    </option>

                                    <option value="Hotel Booking">
                                        Hotel Booking
                                    </option>

                                    <option value="Travel Support">
                                        Travel Support
                                    </option>

                                    <option value="General Enquiry">
                                        General Enquiry
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- MESSAGE -->

                        <div class="mb-4">

                            <label class="form-label">
                                Your Message
                            </label>

                            <textarea class="form-control"
                                      placeholder="Write your message here..."
                                      name="yourmessage"
                                      required></textarea>

                        </div>


                        <!-- BUTTON -->

                        <button type="submit"
                                class="send-btn">

                            <i class="bi bi-send-fill"></i>

                            Send Message

                        </button>


                        <!-- SUCCESS / ERROR MESSAGE -->

                        if (ViewData["x"] != null)
                        {
                            <div class="alert alert-info mt-3">
                                @ViewData["x"]
                            </div>
                        }

                    }

                </div>

            </div>


            <!-- ================= CONTACT INFORMATION ================= -->

            <div class="col-lg-5">

                <div class="contact-card">

                    <h3>
                        Contact Information
                    </h3>


                    <div class="info-box">

                        <div class="info-icon">
                            <i class="bi bi-geo-alt-fill"></i>
                        </div>

                        <div>

                            <h5>Our Office</h5>

                            <p>
                                Pune, Maharashtra, India
                            </p>

                        </div>

                    </div>


                    <div class="info-box">

                        <div class="info-icon">
                            <i class="bi bi-telephone-fill"></i>
                        </div>

                        <div>

                            <h5>Phone</h5>

                            <p>
                                +91 98765 43210
                            </p>

                        </div>

                    </div>


                    <div class="info-box">

                        <div class="info-icon">
                            <i class="bi bi-envelope-fill"></i>
                        </div>

                        <div>

                            <h5>Email</h5>

                            <p>
                                support@travelgo.com
                            </p>

                        </div>

                    </div>


                    <div class="info-box">

                        <div class="info-icon">
                            <i class="bi bi-clock-fill"></i>
                        </div>

                        <div>

                            <h5>Working Hours</h5>

                            <p>
                                Monday - Saturday
                                <br>
                                9:00 AM - 7:00 PM
                            </p>

                        </div>

                    </div>


                    <!-- SOCIAL MEDIA -->

                    <div class="social-icons">

                        <a href="#">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-twitter-x"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-youtube"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- ================= MAP ================= -->

    <section class="map-section">

        <div class="map-box">

            <iframe src="https://www.google.com/maps?q=Pune,Maharashtra,India&output=embed"
                    loading="lazy">
            </iframe>

        </div>

    </section>


    <!-- ================= FOOTER ================= -->

    <footer>

        <p class="mb-0">

            © 2026

            <span>TravelGo</span>

            Tourist Management System.

            All Rights Reserved.

        </p>

    </footer>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
