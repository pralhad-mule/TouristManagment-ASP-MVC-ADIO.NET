
@model TouristManagmentPractice.Models.Users

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <title>User Login</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-image: linear-gradient( rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.55) ), url("https://images.unsplash.com/photo-1500534623283-312aade485b7");
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        /* Login Card */

        .login-container {
            width: 420px;
            padding: 40px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
            color: white;
        }

        /* Logo */

        .logo {
            text-align: center;
            font-size: 55px;
            margin-bottom: 10px;
        }

        /* Heading */

        h1 {
            text-align: center;
            font-size: 30px;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #eeeeee;
            font-size: 14px;
            margin-bottom: 30px;
        }

        /* Form */

        .form-group {
            margin-bottom: 22px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-size: 15px;
                font-weight: bold;
            }

            .form-group input {
                width: 100%;
                padding: 14px;
                border: none;
                outline: none;
                border-radius: 10px;
                font-size: 15px;
                background: rgba(255, 255, 255, 0.95);
                color: #222;
            }

                .form-group input:focus {
                    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.3);
                }

        /* Error */

        .error-message {
            background: rgba(255, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.3);
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 20px;
            color: white;
        }

        /* Login Button */

        .login-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            background: #ff7a00;
            color: white;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

            .login-btn:hover {
                background: #ff9800;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
            }

        /* Register */

        .register {
            text-align: center;
            margin-top: 25px;
            font-size: 14px;
        }

            .register a {
                color: #ffd166;
                font-weight: bold;
                text-decoration: none;
            }

                .register a:hover {
                    text-decoration: underline;
                }

        /* Validation */

        .validation {
            color: #ffcccc;
            font-size: 12px;
            display: block;
            margin-top: 5px;
        }

        /* Mobile */

        @@media (max-width: 500px) {

            .login-container {
                width: 90%;
                padding: 30px 25px;
            }

            h1 {
                font-size: 25px;
            }
        }
    </style>

</head>

<body>

    <div class="login-container">

        <!-- Logo -->

        <div class="logo">
            🌍
        </div>

        <h1>Welcome Back</h1>

        <p class="subtitle">
            Login to Tourist Management System
        </p>


        <!-- Error Message -->

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }


        <!-- Login Form -->

        @using (Html.BeginForm("Userlogin", "Login", FormMethod.Post))
        {

            <!-- Email -->

            <div class="form-group">

                <label>Email Address</label>

                @Html.TextBoxFor(
                    x => x.Email,
                    new
                    {
                        placeholder = "Enter your email",
                        type = "email"
                    })

                @Html.ValidationMessageFor(
                    x => x.Email,
                    "",
                    new { @class = "validation" })

            </div>


            <!-- Password -->

            <div class="form-group">

                <label>Password</label>

                @Html.PasswordFor(
                    x => x.Password,
                    new
                    {
                        placeholder = "Enter your password"
                    })

                @Html.ValidationMessageFor(
                    x => x.Password,
                    "",
                    new { @class = "validation" })

            </div>


            <!-- Login Button -->

            <button type="submit" class="login-btn">
                Login
            </button>

        }


        <!-- Registration Link -->

        <div class="register">

            Don't have an account?

            <a href="@Url.Action("user", "UserRegister")">
                Register Now
            </a>

        </div>

    </div>
    @ViewData["x"]
</body>

</html>

