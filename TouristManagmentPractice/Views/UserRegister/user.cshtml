```cshtml
@model TouristManagmentPractice.Models.Users

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>

    <meta name="viewport" content="width=device-width" />

    <title>Tourist Registration</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        /* ================= BODY ================= */

        body {
            font-family: Arial, Helvetica, sans-serif;
            min-height: 100vh;
            background-image: linear-gradient( rgba(3, 24, 42, 0.72), rgba(3, 24, 42, 0.72) ), url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=2200&q=90");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 15px;
        }


        /* ================= MAIN CARD ================= */

        .main-container {
            width: 100%;
            max-width: 950px;
            min-height: 600px;
            display: flex;
            background: rgba(255, 255, 255, 0.97);
            border-radius: 25px;
            overflow: hidden;
            box-shadow: 0 25px 70px rgba(0, 0, 0, 0.45);
            animation: appear 0.8s ease;
        }


        /* ================= ANIMATION ================= */

        @@keyframes appear {

            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* ================= LEFT IMAGE ================= */

        .image-section {
            width: 42%;
            position: relative;
            background-image: linear-gradient( rgba(0, 150, 180, 0.20), rgba(0, 20, 40, 0.60) ), url("https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1000&q=90");
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: flex-end;
            padding: 35px;
            color: white;
        }


        .image-content {
            position: relative;
            z-index: 2;
        }


            .image-content .icon {
                font-size: 45px;
                margin-bottom: 12px;
            }


            .image-content h1 {
                font-size: 32px;
                margin-bottom: 12px;
                line-height: 1.2;
            }


            .image-content p {
                font-size: 14px;
                line-height: 1.7;
                color: #eeeeee;
            }


        /* ================= FORM SECTION ================= */

        .form-container {
            width: 58%;
            padding: 40px 45px;
            background: #ffffff;
        }


            /* ================= HEADING ================= */

            .form-container h2 {
                text-align: center;
                font-size: 32px;
                color: #071c2c;
                margin-bottom: 8px;
                font-weight: 700;
            }


        .heading-text {
            text-align: center;
            color: #777;
            font-size: 14px;
            margin-bottom: 25px;
        }


        .form-container h2::after {
            content: "";
            display: block;
            width: 65px;
            height: 4px;
            background: linear-gradient( 90deg, #00aeca, #00d9ff );
            border-radius: 10px;
            margin: 10px auto 0;
        }


        /* ================= FORM ================= */

        .form-group {
            margin-bottom: 15px;
        }


        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            color: #333;
            font-size: 13px;
        }


        /* ================= INPUTS ================= */

        input[type="text"],
        input[type="email"],
        input[type="password"],
        input[type="tel"],
        textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #d8d8d8;
            border-radius: 9px;
            font-size: 14px;
            outline: none;
            transition: all 0.3s ease;
            background: #fff;
            font-family: Arial, Helvetica, sans-serif;
        }


        textarea {
            min-height: 75px;
            resize: vertical;
        }


            /* ================= INPUT FOCUS ================= */

            input[type="text"]:focus,
            input[type="email"]:focus,
            input[type="password"]:focus,
            input[type="tel"]:focus,
            textarea:focus {
                border-color: #00cfe8;
                box-shadow: 0 0 0 3px rgba(0, 207, 232, 0.12);
                transform: translateY(-1px);
            }


            input::placeholder,
            textarea::placeholder {
                color: #aaa;
            }


        /* ================= HINT ================= */

        .hint {
            font-size: 11px;
            color: #888;
            margin-top: 4px;
        }


        /* ================= VALIDATION ================= */

        .validation-summary {
            margin-bottom: 15px;
            padding: 10px;
            color: #b00020;
            background: #fff0f0;
            border-radius: 7px;
            font-size: 13px;
        }


        /* ================= BUTTON ================= */

        .actions {
            margin-top: 22px;
        }


        .btn {
            width: 100%;
            padding: 14px 20px;
            border: none;
            border-radius: 30px;
            background: linear-gradient( 90deg, #00aeca, #00d9ff );
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 7px 18px rgba(0, 180, 220, 0.20);
        }


            .btn:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 28px rgba(0, 180, 220, 0.35);
            }


            .btn:active {
                transform: translateY(0);
            }


        /* ================= LOGIN LINK ================= */

        .login-link {
            text-align: center;
            margin-top: 18px;
            color: #777;
            font-size: 13px;
        }


            .login-link a {
                color: #00aeca;
                text-decoration: none;
                font-weight: 600;
            }


                .login-link a:hover {
                    text-decoration: underline;
                }


        /* ================= SUCCESS MESSAGE ================= */

        .success-message {
            text-align: center;
            color: #16803c;
            background: #edfff3;
            padding: 10px;
            border-radius: 7px;
            margin-bottom: 15px;
        }


        /* ================= TABLET ================= */

        @@media (max-width: 800px) {

            .main-container {
                max-width: 520px;
            }

            .image-section {
                display: none;
            }

            .form-container {
                width: 100%;
                padding: 40px;
            }
        }


        /* ================= MOBILE ================= */

        @@media (max-width: 500px) {

            body {
                padding: 20px 12px;
            }

            .main-container {
                border-radius: 18px;
            }

            .form-container {
                padding: 30px 22px;
            }

                .form-container h2 {
                    font-size: 27px;
                }
        }
    </style>

</head>


<body>


    <div class="main-container">


        <!-- ================= IMAGE SECTION ================= -->

        <div class="image-section">

            <div class="image-content">

                <div class="icon">
                    🌍
                </div>

                <h1>
                    Explore The World
                </h1>

                <p>
                    Create your account and start
                    exploring beautiful destinations,
                    exciting adventures and unforgettable
                    journeys.
                </p>

            </div>

        </div>


        <!-- ================= FORM SECTION ================= -->

        <div class="form-container">

            <h2>
                Create Account
            </h2>

            <p class="heading-text">
                Join our Tourist Management System
            </p>


            @using (Html.BeginForm(
                "user",
                "UserRegister",
                FormMethod.Post))
            {

                @Html.AntiForgeryToken()


                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "validation-summary" }
                )


                <!-- ================= NAME ================= -->

                <div class="form-group">

                    <label for="Name">
                        Full Name
                    </label>

                    <input id="Name"
                           name="Name"
                           type="text"
                           placeholder="Enter your full name"
                           required
                           maxlength="100" />

                </div>


                <!-- ================= EMAIL ================= -->

                <div class="form-group">

                    <label for="Email">
                        Email Address
                    </label>

                    <input id="Email"
                           name="Email"
                           type="email"
                           placeholder="Enter your email"
                           required
                           maxlength="256" />

                </div>


                <!-- ================= PASSWORD ================= -->

                <div class="form-group">

                    <label for="Password">
                        Password
                    </label>

                    <input id="Password"
                           name="Password"
                           type="password"
                           placeholder="Create a password"
                           required
                           minlength="6"
                           maxlength="100" />

                    <div class="hint">
                        Minimum 6 characters
                    </div>

                </div>


                <!-- ================= CONFIRM PASSWORD ================= -->

                <div class="form-group">

                    <label for="ConfirmPassword">
                        Confirm Password
                    </label>

                    <input id="ConfirmPassword"
                           name="ConfirmPassword"
                           type="password"
                           placeholder="Confirm your password"
                           required
                           minlength="6"
                           maxlength="100" />

                </div>


                <!-- ================= PHONE ================= -->

                <div class="form-group">

                    <label for="Phone">
                        Phone Number
                    </label>

                    <input id="Phone"
                           name="Phone"
                           type="tel"
                           placeholder="Enter phone number"
                           pattern="[0-9()+\- ]{7,20}"
                           maxlength="20" />

                </div>


                <!-- ================= ADDRESS ================= -->

                <div class="form-group">

                    <label for="Address">
                        Address
                    </label>

                    <textarea id="Address"
                              name="Address"
                              placeholder="Enter your address"></textarea>

                </div>


                <!-- ================= BUTTON ================= -->

                <div class="actions">

                    <button type="submit" class="btn">

                        Create Account

                    </button>

                </div>

            }


            <!-- ================= LOGIN ================= -->

            <div class="login-link">

                Already have an account?

                <a href="@Url.Action("Userlogin", "Login")">
                    Login Here
                </a>

            </div>


            @ViewData["x"]

        </div>

    </div>


</body>

</html>
```
